############################
#distance distribution
#############################
library(ggplot2)
library(gridExtra)
library(grid)
library(tidyr)
###############
##normality test
rep <- 4
flist <- list.files(paste0('/Users/prm2zt/Documents/UVA/Zanglab/project/WangLab/MengweiCarolHu/Similarity/FetalLiver/Step1_Distance_TADbyTrace/results/Replicate', rep, '/'), pattern = "\\.tsv")
flist1 <- as.character(data.frame(strsplit(flist, "[._]"))[3,])
k <- 6
assign(flist1[k], read.table(paste0('/Users/prm2zt/Documents/UVA/Zanglab/project/WangLab/MengweiCarolHu/Similarity/FetalLiver/Step1_Distance_TADbyTrace/results/Replicate', rep, '/', flist[k]),))
pr_num <- dim(get(flist1[k]))[1]
normality <- matrix(ncol=1, nrow=pr_num)
normality_log <- matrix(ncol=1, nrow=pr_num)
for (j in 1:pr_num){
normality[j,1] <- ks.test(as.numeric(get(flist1[k])[j,]), 'pnorm', mean=mean(as.numeric(get(flist1[k])[j,]), na.rm = TRUE), sd=sd(as.numeric(get(flist1[k])[j,]), na.rm = TRUE))$p.value
normality_log[j,1] <- ks.test(log(1+as.numeric(get(flist1[k])[j,])), 'pnorm', mean=mean(log(1+as.numeric(get(flist1[k])[j,])), na.rm = TRUE), sd=sd(log(1+as.numeric(get(flist1[k])[j,])), na.rm = TRUE))$p.value
}
dataplot0 <- data.frame(normality = -log10(p.adjust(normality, method = "BH")),
normality_log = -log10(p.adjust(normality_log, method = "BH")))
dataplot <- dataplot0[order(dataplot0$normality_log), ]
dataplot$index <- seq(1,pr_num,1)
dataplot1 <-  reshape2::melt(dplyr::mutate(dataplot, index), id="index")
pdf(paste0('KStest_adj_p.pdf'), width = 5.5, height = 4.5)
ggplot(dataplot1, aes(x=index, y=value, colour=variable))+
geom_line(aes(group = index), color = "lightgray", size=0.2) +
geom_point(alpha=0.7, size=0.5)+
theme_bw()+
theme(legend.position = c(0.25, 0.9),
legend.title = element_blank(),
legend.box.background = element_rect(color = "black"),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank())+
scale_color_manual(
values = c("normality" = "#e55709", "normality_log" = "#1c8041"),
labels = c("Original spatial distance", "Log-transformed spatial distance"))+
labs(y="-log10(adj.p value)", x="Region pairs label",
title = "K-S test for normality")
dev.off()
df_long <- pivot_longer(dataplot, cols = c(normality, normality_log),
names_to = "variable", values_to = "value")
# Density plot
pdf(paste0('p_distribution.pdf'), width = 4, height = 3)
ggplot(df_long, aes(x = value, color = variable)) +
geom_density(alpha = 0.4) +
labs(title = "",
x = "-log10(adj.p value)", y = "Density") +
theme_bw()+
scale_color_manual(
values = c("normality" = "#e55709", "normality_log" = "#1c8041"),
labels = c("Original spatial distance", "Log-transformed spatial distance"))+
theme(legend.position = c(0.6, 0.7),
legend.title = element_blank(),
legend.box.background = element_rect(color = "black"),
#legend.box.margin = margin(t = -10, r = 0, b = -10, l = 0),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank())
dev.off()
