library(ggplot2)
convert_to_vector <- function(region_string) {
# Remove the "region:" prefix and split by comma
region_numbers <- unlist(strsplit(sub("region:", "", region_string), ","))
# Convert the split strings to numeric and create a vector
region_vector <- as.numeric(region_numbers)
return(region_vector)
}
geneset0 <- read.table('SourceData/GeneTSSandPromoterRegion_update.tsv', header = TRUE)
DS <- read.table('SourceData/CPD_CID_DiffScore.txt', sep = "\t", header = TRUE)
geneset <- geneset0[which(geneset0$GeneName %in% c("Anxa8", "Myc", "Mycn", "Fhit", "Oit1")), ] #since the DiffRegion Num are different, so plot them one by one.
geneset$label <- geneset$Gene
geneset$label[which(geneset$label == "Oit1")] <- "Fam3d"
for(k in c(1,4,5)){
gene <- geneset$Gene[k]
genename <- geneset$GeneName[k]
geneid <- geneset$GeneID[k]
pmt_rg <- convert_to_vector(geneset[["Promoter2kInRegion"]][k])
#### in state 3
load(paste0('SourceData/Distance_Compare_Background/', genename, '.RData'))
data <- read.table(paste0('SourceData/DistanceS3_OriginalDistanceDF/S3PromoterDistance_', genename, '_R', pmt_rg, '.tsv'))
colnames(data) <-  paste0('R', seq(1, dim(data)[2], 1))
datafg <- lapply(data, as.vector)
databg <- get(genename)[c(abs(seq(1, dim(data)[2]) -pmt_rg) +1)]
data_frame <- data.frame(
Value = c(unlist(datafg), unlist(databg)),
List = factor(rep(c("PromoterRow", "Background"), times = c(length(unlist(datafg)), length(unlist(databg))))),
Element = factor(c(rep(1:length(datafg), times = sapply(datafg, length)), rep(1:length(databg), times = sapply(databg, length))))
)
dsge <- DS[which(DS$Gene_Region == paste0(genename, '_R', pmt_rg) & DS$S3vS2_p1e.05 == 1),]
dsger <- sub("Region", "", dsge$region)
dataplot <- data_frame[which(data_frame$Element == dsger),]
length(unique(dataplot$Element))
uq <- unique(dataplot$Element)
pv1 <- wilcox.test(dataplot$Value[which(dataplot$List == "PromoterRow" & dataplot$Element == uq[1])], dataplot$Value[which(dataplot$List == "Background" & dataplot$Element == uq[1])], alternative = "less")
pv2 <- wilcox.test(dataplot$Value[which(dataplot$List == "PromoterRow" & dataplot$Element == uq[2])], dataplot$Value[which(dataplot$List == "Background" & dataplot$Element == uq[2])], alternative = "less")
p <- ggplot(dataplot, aes(x = Element, y = Value, fill = List)) +
geom_boxplot(outliers = FALSE) +
labs(x = "Region ID", y = "Spatial distance", fill=NULL) +
theme_bw()+
theme(legend.title = element_blank(),
legend.position = "top",
legend.margin = margin(t = 0, r = 0, b = -10, l = 0),
panel.grid.major = element_blank(),  # Remove major gridlines
panel.grid.minor = element_blank(),
axis.title = element_text(size = 10),
axis.text = element_text(size = 10)) +  # Improve x-axis label readability
scale_fill_manual(values = c("PromoterRow" = "#e47159", "Background" = "#3d5c6f"),
labels = c("PromoterRow" = paste0(geneset$label[k], " Promoter"), "Background" = "Background")) +  # Colors for the lists. #y = max(Value, na.rm = TRUE)*2/3),
annotate("text", label = paste0("p=",as.character(signif(pv1$p.value, 2))),
x=uq[1], y = 0.65, vjust = -0.5, hjust=0.3, size=3) +  ##annotate is better than geom_text!!!!!
annotate("text", label = paste0("p=",as.character(signif(pv2$p.value, 2))),
x=uq[2], y = 0.65, vjust = -0.5, hjust=0.3, size=3)
pdf(paste0('S3_DisAndBg', genename, '_R', pmt_rg, '.pdf'), width = 3, height = 2)
print(p)
dev.off()
rm(list = genename)
}
