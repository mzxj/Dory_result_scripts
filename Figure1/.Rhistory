theme_bw()+
labs(x=paste0("Trace count"), y="Reproducibility rate",title=paste0("Top 50/1225 region pairs (",directions[i, 2], ")" ))+
#labs(x=paste0("Number of traces"), y="Reproducibility rate",title="Top10 DRP")+
#labs(x="", y="Reproducibility rate", title = paste0("Sub ", obj1, " traces"))+
theme(legend.position = 'none',
axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1, size=10),
axis.text.y = element_text(size=10),
axis.title = element_text(size = 10),
text=element_text(size=10),
panel.grid.major = element_blank(),  # Remove major gridlines
panel.grid.minor = element_blank(),
plot.title = element_text(size = 10))+
scale_y_continuous(limits = c(0, 1))#+
